{
  "name": "pampo-karaoke",
  "private": true,
  "version": "1.1.0",
  "description": "Pampo Karaokê - Sistema profissional de karaokê web com suporte a múltiplos microfones, efeitos de áudio em tempo real e busca integrada do YouTube",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "desktop": "electron electron/main.cjs",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "tech.pampo.karaoke",
    "productName": "Pampo-Karaoke",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-v${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pampo Karaokê",
      "artifactName": "${productName}-v${version}-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-Portatil.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ]
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.17",
    "yt-search": "^2.13.1"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
